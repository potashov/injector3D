# Артефакты, воспроизводимые из исходников
blend/
__pycache__/
*.pyc
*.bkp

# Промежуточные сцены Blender тяжёлые (~1 МБ/кадр) и восстанавливаются
# запуском скрипта.  Сами рендеры (PNG) — результат работы, они в репозитории.
output/**/*.blend
output/**/*.blend1
output/**/*.log

# Локальные настройки Blender
*.blend1

# Локальные сборки Blender (скачиваются отдельно, не коммитятся)
blender-4.3.2-linux-x64/
blender-5.2.3-linux-x64/
